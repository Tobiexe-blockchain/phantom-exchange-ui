# demo (default): simulated in the browser, no server needed. This is what the hosted demo uses.
# mock: the Socket.io demo server (npm run mock). engine: phantom-matcher over HTTP and WebSocket.
NEXT_PUBLIC_DATA_SOURCE=demo
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Used when NEXT_PUBLIC_DATA_SOURCE=engine
NEXT_PUBLIC_ENGINE_HTTP_URL=http://localhost:8080
NEXT_PUBLIC_ENGINE_WS_URL=ws://localhost:8080
